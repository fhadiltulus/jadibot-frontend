# Config publik Firebase (aman ditaruh di frontend, BEDA sama service account di backend)
# Ambil dari: Firebase Console > Project Settings > General > Your apps > Web app (klik ikon </>)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bot-wa-adin2207
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL backend jadibot-manager kamu (yang jalan di Pterodactyl), contoh: https://jadibot-api.namadomainkamu.com
NEXT_PUBLIC_API_BASE_URL=
